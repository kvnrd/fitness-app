# Copy to `.env` (git-ignored). Placeholders only: never commit real values.
#
# EXPO_PUBLIC_* variables are bundled into the app and readable by anyone who
# has the app. Never put secrets (service-role keys, API secrets) in them.
#
# Dev-only Studio preview (ignored when __DEV__ is false, and ignored when Supabase is configured):
# EXPO_PUBLIC_DEV_ROLE=athlete   # athlete | coach_pending | coach_verified
#
# Supabase (public URL + anon key only). Leave unset/placeholder to run the in-memory prototype.
# EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id
#
# SERVER ONLY, never in the app or any EXPO_PUBLIC_* var: Supabase service-role key,
# encryption keys, Apple/Google secrets. Set those in the server/Edge Function environment.

# Product analytics and crash reports (public keys only; no user ID is ever attached).
# Leave unset to keep both vendors off. PostHog retains 12 months; Sentry 90 days.
# EXPO_PUBLIC_POSTHOG_KEY=
# EXPO_PUBLIC_SENTRY_DSN=

# SERVER ONLY — Apple WeatherKit (Edge Function). Never EXPO_PUBLIC_*.
# WEATHERKIT_TEAM_ID=
# WEATHERKIT_KEY_ID=
# WEATHERKIT_SERVICE_ID=
# WEATHERKIT_PRIVATE_KEY=

# Hosting / KMS region is AWS us-west-1 (see src/config/region.ts).

# Phase 6: Stripe Identity (document-only, no selfie). Restricted keys only.
# Never put Stripe secret or restricted keys in EXPO_PUBLIC_* variables.
# STRIPE_RESTRICTED_KEY=
# STRIPE_SECRET_KEY=
